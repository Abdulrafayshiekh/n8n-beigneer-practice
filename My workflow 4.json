    },
    {
      "parameters": {
        "jsCode": "const articles = $input.all();\n\nconst oneDayAgo = Date.now() - (24 * 60 * 60 * 1000);\n\nconst newArticles = articles.filter(item => {\n  const articleDate =\n    item.json.isoDate ||\n    item.json.pubDate ||\n    item.json.date;\n\n  if (!articleDate) return true;\n\n  const timestamp = new Date(articleDate).getTime();\n\n  return timestamp >= oneDayAgo;\n});\n\nif (newArticles.length === 0) {\n  return [];\n}\n\nlet digest = `DAILY RSS DIGEST\\n\\n`;\n\nnewArticles.forEach((item, index) => {\n\n  const title = item.json.title || 'Untitled article';\n  const link = item.json.link || '';\n  const date =\n    item.json.pubDate ||\n    item.json.isoDate ||\n    '';\n\n  digest += `${index + 1}. ${title}\\n`;\n\n  if (date) {\n    digest += `Published: ${date}\\n`;\n  }\n\n  digest += `${link}\\n\\n`;\n});\n\nreturn [\n  {\n    json: {\n      articleCount: newArticles.length,\n      digest: digest\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
